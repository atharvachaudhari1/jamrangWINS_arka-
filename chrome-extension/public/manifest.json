{
  "manifest_version": 3,
  "name": "Doorway",
  "version": "1.0.0",
  "description": "Doorway — one small step at a time. Tasks, focus timer, and academic planning in your browser.",
  "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest", "tabs", "idle", "identity", "scripting", "offscreen"],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://*.railway.app/*",
    "https://*.vercel.app/*",
    "*://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://your-app.vercel.app/*"
    ]
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Doorway",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
