# Frontend environment. Copy to frontend/.env.local and fill in real values.
# Do not commit .env.local.

# Backend API. Local default works if this is unset.
VITE_API_URL=http://localhost:4000/api

# Same value as GOOGLE_CLIENT_ID. Required for Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Same value as VAPID_PUBLIC_KEY. Required only for browser push.
VITE_VAPID_PUBLIC_KEY=

# Optional. Chrome extension id for automatic sign-in sync.
VITE_EXTENSION_ID=

# Optional. Your own Buy Me a Coffee page. Leave blank to keep the button disabled.
# Example: https://buymeacoffee.com/your-name
VITE_BUY_ME_A_COFFEE_URL=
