# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
BACKEND_URL=https://your-backend.onrender.com
FRONTEND_URL=https://your-vercel-app.vercel.app

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bouncybrain

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Third-party APIs ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Slack OAuth ───────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# ── ML Microservice ───────────────────────────────────────────────────────────
ML_PRIORITY_URL=https://ml-service.onrender.com

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate a key pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:you@example.com

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Optional Doorway features ─────────────────────────────────────────────────
# ElevenLabs reads the Today card aloud. Leave blank to use browser speech only.
# The core planner works without this key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Local-only shorter thresholds for the Smart Focus Nudge. Leave false in production.
NUDGE_DEMO_MODE=false
